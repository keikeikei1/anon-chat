{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anon-chat",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "LOBBY", "class_name": "Lobby" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Lobby"] }],
  "routes": [{ "pattern": "anon-chat.example.com", "custom_domain": true }],
  "vars": {
    "ADMIN_KEY": "CHANGE_ME_random_admin_key",
    "IP_SALT": "CHANGE_ME_random_salt"
  },
  "observability": { "enabled": true }
}
